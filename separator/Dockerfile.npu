# NPU preview only; deliberately separate from the stable CPU/PC worker image.
FROM openvino/ubuntu24_runtime:2026.3.0
USER root
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg python3-venv ca-certificates && rm -rf /var/lib/apt/lists/*
RUN python3 -m venv --system-site-packages /opt/npu-venv
ENV PATH=/opt/npu-venv/bin:$PATH
RUN pip install --no-cache-dir numpy==1.26.4 fastapi==0.115.12 uvicorn==0.34.2 python-multipart==0.0.20 \
    && python -c "import openvino, numpy; print(openvino.__version__, numpy.__version__)"
WORKDIR /app
COPY npu_model.py ./
RUN python npu_model.py /opt/models
COPY DEMUCS-LICENSE.txt INTEL-MODEL-CARD.md /opt/models/
COPY app.py job_store.py inference.py upload_guard.py clipping.py video_encoding.py npu_inference.py npu_detection.py smoke_npu.py ./
ENV SEPARATION_BACKEND=openvino-npu SEPARATION_DEVICE=NPU SEPARATION_CONCURRENCY=1 NPU_MODEL_PATH=/opt/models/htdemucs_fwd.xml NPU_CACHE_DIR=/data/npu-cache
LABEL org.opencontainers.image.version="0.4.6.rc1" org.opencontainers.image.description="Experimental Intel NPU htdemucs worker; not latest"
CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8000"]
